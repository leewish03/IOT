APP_ENV=local
APP_TIMEZONE=Asia/Seoul
APP_DATA_DIR=/app/data
APP_POLICIES_DIR=/app/policies
APP_DEFAULT_DEVICE_ID=relay_esp12e_room_a
BACKEND_API_TOKEN=change-me
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=home
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=change-me
HOME_ASSISTANT_ALARM_SERVICE=script.iot_alarm_run
CALENDAR_PROVIDER=file
CALENDAR_FILE=/app/data/calendar_events.json
