# Next.js dashboard — copy to web.env and edit before compose up
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Orchestrator (Docker service name on the compose network)
ORCHESTRATOR_URL=http://orchestrator:8080
ORCHESTRATOR_TOKEN=change-me

# LLM keys (required for chat / voice / vision)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional Supabase (chat history / settings)
NEXT_PUBLIC_SUPABASE_URL=https://wyqpcldqlyrqbppjdhhp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
