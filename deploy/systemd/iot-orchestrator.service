[Unit]
Description=IoT orchestrator container (ensure running after compose)
Documentation=file:///opt/iot-home/docs/06-guide/pi-deploy.md
PartOf=iot-stack.target
After=iot-docker.service
Requires=iot-docker.service
BindsTo=iot-docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/iot-home/deploy/docker-compose
Environment=COMPOSE_PROJECT_NAME=iot-home
ExecStart=/usr/bin/docker compose up -d mqtt orchestrator
ExecStop=/usr/bin/docker compose stop orchestrator
TimeoutStartSec=300

[Install]
WantedBy=iot-stack.target
